{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "rootDir": "engine/src",
    "outDir": "build/engine",
    "declaration": false,
    "skipLibCheck": true
  },
  "include": ["engine/src/**/*.ts"]
}
